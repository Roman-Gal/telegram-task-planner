# Copy to .env. Never commit real secrets.
TELEGRAM_BOT_TOKEN=
# At least 32 characters: letters, digits, underscore or hyphen.
WEBHOOK_SECRET=
# ngrok HTTPS origin, without a path. scripts/start-ngrok.ps1 sets this automatically.
PUBLIC_BASE_URL=
PORT=8080
HOST=127.0.0.1
TIMEZONE=Europe/Warsaw
DATABASE_PATH=./data/planner.sqlite
# Optional comma-separated Telegram chat IDs. Empty allows all groups.
ALLOWED_CHAT_IDS=
# Optional bot owner's numeric Telegram user ID. When set, only groups approved
# by this owner (or explicitly listed above) are allowed. Use /id to find your ID.
OWNER_USER_ID=
